{
  "name": "personal-catalog-template",
  "version": "0.0.1",
  "description": "Template desplegable para publicar un catálogo personal de servicios (y productos) con Cloudflare Pages y Workers KV",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler pages dev public --ip 0.0.0.0 --port 8788",
    "deploy": "wrangler pages deploy public",
    "deploy:pages": "wrangler pages deploy public",
    "test": "node --test test/*.test.mjs",
    "test:integracion": "node --test --test-timeout=60000 --test-reporter=./test/integracion/reporte.mjs test/integracion/*.test.mjs"
  },
  "keywords": [
    "cloudflare",
    "pages",
    "kv",
    "catalog",
    "personal",
    "template"
  ],
  "author": "opencode",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/personal-ecommerce.git"
  },
  "type": "module"
}
